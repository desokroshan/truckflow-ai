# TruckFlow AI - Production Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=5000
BASE_URL=https://yourdomain.com

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
SESSION_SECRET=your-very-long-random-secret-key-replace-this-with-actual-secret
JWT_SECRET=your-jwt-secret-key-replace-this-with-actual-secret
CORS_ORIGIN=https://yourdomain.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/truckflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=truckflow
DB_USER=username
DB_PASSWORD=password

# =============================================================================
# OPENAI CONFIGURATION (Required for AI Processing)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_WHISPER_MODEL=whisper-1

# =============================================================================
# TWILIO CONFIGURATION (Required for Phone System)
# =============================================================================
TWILIO_ACCOUNT_SID=ACyour-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_URL=https://yourdomain.com/api/twilio

# =============================================================================
# EMAIL CONFIGURATION (Required for Notifications)
# =============================================================================
EMAIL_PROVIDER=gmail
EMAIL_USER=your-business-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_NOTIFICATION_RECIPIENT=owner@company.com

# =============================================================================
# SMS CONFIGURATION (Optional)
# =============================================================================
SMS_ENABLED=true
SMS_PHONE_NUMBER=+1234567890

# =============================================================================
# GOOGLE SHEETS INTEGRATION (Optional)
# =============================================================================
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID=1ABC123-your-spreadsheet-id-here
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Google Service Account Private Key\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com

# =============================================================================
# GOOGLE MAPS ADDRESS VALIDATION (Optional but Recommended)
# =============================================================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=10MB
RECORDING_RETENTION_DAYS=30

# =============================================================================
# BUSINESS CONFIGURATION (Client-Specific)
# =============================================================================
COMPANY_NAME="Your Company Name"
COMPANY_PHONE="+1234567890"
COMPANY_EMAIL="info@company.com"
BUSINESS_HOURS="8:00 AM - 6:00 PM EST"
SERVICE_AREAS="TX,OK,NM,LA,AR"

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
DAILY_REPORT_ENABLED=true
WEEKLY_REPORT_ENABLED=true

# =============================================================================
# SYSTEM LIMITS
# =============================================================================
MAX_CALL_DURATION=300
MAX_CONCURRENT_CALLS=10
API_RATE_LIMIT=100
MAX_LOADS_PER_DAY=50

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=info
ERROR_REPORTING_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true
AUDIT_LOG_ENABLED=true

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================
# TMS_INTEGRATION_ENABLED=false
# TMS_API_KEY=your-tms-api-key
# TMS_WEBHOOK_URL=https://yourdomain.com/api/tms

# ACCOUNTING_INTEGRATION_ENABLED=false
# QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
# QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret