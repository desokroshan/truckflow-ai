# TruckFlow Production Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/database
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-password
PGDATABASE=truckflow

# Application Environment
NODE_ENV=production
PORT=5000

# AI & Communication APIs
OPENAI_API_KEY=sk-your-openai-key-here
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Address Validation
USPS_USER_ID=your-usps-user-id

# Security (generate random 32+ character strings)
JWT_SECRET=your-random-jwt-secret-minimum-32-characters
SESSION_SECRET=another-random-secret-for-sessions-minimum-32-characters

# Email Configuration (optional - for Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Google Sheets Integration (optional)
GOOGLE_SHEETS_ID=your-sheet-id
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"